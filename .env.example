
# 1. Base de Datos MySQL 8.0
# Contraseña del superusuario root de MySQL
MYSQL_ROOT_PASSWORD=root_secure_password_123

# Nombre de la base de datos principal que creará MySQL automáticamente
MYSQL_DATABASE=ecommerce_db

# Usuario regular para la aplicación (principio de menor privilegio)
MYSQL_USER=ecommerce_user

# Contraseña del usuario regular de la base de datos
MYSQL_PASSWORD=ecommerce_password_123

# 2. Backend Laravel (API REST)
# Nombre de la aplicación
APP_NAME=TechStoreAPI

# Entorno de ejecución: 'production' o 'local'
APP_ENV=production

# Modo depuración (false en producción por seguridad)
APP_DEBUG=false

# Clave de cifrado de la aplicación (base64). Si se deja vacía, el entrypoint la genera
APP_KEY=base64:s9N1X8vF1uH8v5G4B2zK9wR8yM0qP7vS6xZ2aT1mC4E=

# URL pública o interna del backend
APP_URL=http://localhost:8000

# Secreto para tokens de autenticación JWT (tymon/jwt-auth)
JWT_SECRET=ecommerce_jwt_secret_token_change_in_production_key_12345

RUN_MIGRATIONS=true

RUN_SEEDERS=true


LARAVEL_API_URL=http://backend:8000

# Puerto de ejecución del servidor Next.js dentro del contenedor
PORT=3000
